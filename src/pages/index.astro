const partners = ['axon', 'Jetstar', 'Expedia', 'QANTAS', 'Alitalia'];

const testimonials = [
	{
		quote:
			'On the Windows talking painted pasture yet its express parties use. Sure last upon he same as knew next. Of believed or diverted no.',
		name: 'Mike taylor',
		location: 'Lahore, Pakistan',
		avatar: 'https://i.pravatar.cc/120?img=14',
	},
	{
		quote:
			'Jadoo made our long-haul planning effortless. The route suggestions were clear, and every booking step felt fast and stress-free.',
		name: 'Chris Thomas',
		location: 'CEO of Red Button',
		avatar: 'https://i.pravatar.cc/120?img=21',
	},
	{
		quote:
			'I booked a multi-city route in minutes. Everything was clear, and the support team helped us adjust dates without any hassle.',
		name: 'Valentina Rios',
