---

<Layout title="Jadoo | Travel Beyond Borders" description="Astro and Tailwind recreation of a travel agency landing page.">
	<main id="top" class="relative isolate overflow-hidden">
		<div class="pointer-events-none absolute inset-x-0 top-0 -z-20 h-[760px] bg-[radial-gradient(circle_at_top_right,_rgba(255,234,197,0.95),_transparent_38%),radial-gradient(circle_at_12%_14%,_rgba(223,105,81,0.08),_transparent_20%)]"></div>
		<div class="pointer-events-none absolute right-[-6rem] top-[-8rem] -z-10 h-[420px] w-[560px] rounded-full bg-[#fff1da]/80 blur-3xl"></div>
		<div class="pointer-events-none absolute left-[-8rem] top-[58rem] -z-10 h-[360px] w-[360px] rounded-full bg-[#f7f3eb] blur-[140px]"></div>

		<div class="mx-auto max-w-[1180px] px-6 pb-16 pt-6 lg:px-8 lg:pb-24">
			<header class="flex flex-wrap items-center justify-between gap-6">
				<a href="#top" class="text-[2rem] font-black tracking-[-0.05em] text-jadoo-ink">Jad<span class="text-jadoo-orange">oo</span></a>

				<nav aria-label="Primary" class="hidden items-center gap-9 md:flex">
					{
						navigation.map((item) => (
							<a class="nav-link" href={item.href}>{item.label}</a>
						))
					}
				</nav>

				<div class="hidden items-center gap-6 md:flex">
					<a href="#testimonials" class="text-sm font-medium text-jadoo-ink/85 transition hover:text-jadoo-ink">
						Login
					</a>
					<a
						href="#newsletter"
						class="rounded-xl border border-jadoo-ink/20 px-5 py-3 text-sm font-medium text-jadoo-ink transition hover:border-jadoo-orange hover:text-jadoo-orange"
					>
						Sign up
					</a>
					<button
						type="button"
						class="inline-flex items-center gap-2 text-sm font-medium text-jadoo-ink/85 transition hover:text-jadoo-ink"
					>
						EN
						<svg class="h-3 w-3" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
							<path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
						</svg>
					</button>
				</div>

				<a
					href="#newsletter"
					class="inline-flex items-center rounded-xl border border-jadoo-ink/15 px-4 py-2 text-sm font-medium text-jadoo-ink md:hidden"
				>
					Plan trip
				</a>
			</header>

			<section class="relative grid items-center gap-14 pb-24 pt-10 lg:grid-cols-[1.02fr_0.98fr] lg:pb-28 lg:pt-14">
				<div class="reveal-up max-w-[610px]">
					<p class="section-kicker">Best Destinations Around The World</p>
					<h1 class="mt-6 max-w-[680px] text-balance text-[3.4rem] font-bold leading-[0.96] tracking-[-0.05em] text-jadoo-ink sm:text-[4.7rem] lg:text-[5.55rem]">
						Travel,
						<span class="relative inline-block after:absolute after:bottom-3 after:left-0 after:right-0 after:-z-10 after:h-3 after:rounded-full after:bg-jadoo-orange/25">
							enjoy
						</span>
						and live a new and full life
					</h1>
					<p class="mt-8 max-w-[520px] text-base leading-8 text-jadoo-body/90">
						Built Wicket longer admire do barton vanity itself do in it. Preferred to sportsmen it engrossed listening. Park gate sell they west hard for the.
					</p>

					<div class="mt-10 flex flex-col gap-5 sm:flex-row sm:items-center">
						<a class="cta-primary" href="#destinations">Find out more</a>
						<a class="cta-ghost" href="#bookings">
							<span class="flex h-14 w-14 items-center justify-center rounded-full bg-jadoo-orange text-white shadow-[0_16px_34px_rgba(223,105,81,0.28)]">
								<svg class="h-4 w-4 translate-x-[1px]" viewBox="0 0 14 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
									<path d="M1 1.4V14.6C1 15.37 1.84 15.85 2.5 15.46L12.82 9.86C13.48 9.48 13.48 8.52 12.82 8.14L2.5 2.54C1.84 2.15 1 2.63 1 3.4Z" fill="white"></path>
								</svg>
							</span>
							<span>Play Demo</span>
						</a>
					</div>
				</div>

				<div class="relative flex justify-center lg:justify-end">
					<div class="hero-orb absolute right-0 top-4 h-[540px] w-[540px] rounded-full sm:h-[620px] sm:w-[620px]"></div>
					<div class="absolute left-2 top-24 hidden h-20 w-20 rounded-[22px] bg-white/80 p-4 shadow-[0_18px_42px_rgba(24,30,75,0.12)] backdrop-blur lg:block animate-float-fast">
						<div class="h-full w-full" set:html={planeIcon}></div>
					</div>
					<div class="absolute right-8 top-36 hidden h-18 w-18 rounded-[22px] bg-white/75 p-3 shadow-[0_18px_42px_rgba(24,30,75,0.12)] backdrop-blur lg:block animate-sway">
						<div class="h-full w-full" set:html={planeIcon}></div>
					</div>

					<div class="relative z-10 w-full max-w-[540px] reveal-up" style="animation-delay: 180ms;">
						<div class="absolute -right-4 top-14 h-18 w-18 rounded-full bg-jadoo-orange/12 blur-2xl"></div>
						<div class="relative overflow-hidden rounded-[46%_54%_40%_60%/34%_39%_61%_66%] border-[12px] border-white/70 bg-[#f9ead0] shadow-[0_38px_90px_rgba(24,30,75,0.16)]">
							<img
								src="https://images.unsplash.com/photo-1527631746610-bca00a040d60?auto=format&fit=crop&w=1200&q=80"
								alt="Traveler with a backpack planning her next adventure"
								class="h-[620px] w-full object-cover object-center"
								decoding="async"
								fetchpriority="high"
							/>
						</div>

						<div class="absolute -bottom-6 left-6 rounded-[28px] bg-white px-6 py-4 shadow-[0_20px_42px_rgba(24,30,75,0.12)] backdrop-blur">
							<p class="text-[0.65rem] font-semibold uppercase tracking-[0.28em] text-jadoo-body/60">Popular Route</p>
							<p class="mt-1 text-lg font-semibold text-jadoo-ink">Rome to Santorini</p>
							<div class="mt-2 flex items-center gap-3 text-sm text-jadoo-body">
								<span class="inline-flex items-center gap-2">
									<svg class="h-4 w-4 text-jadoo-orange" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
										<path d="M2 9.1L13.3 3.7C13.68 3.52 14.13 3.79 14.13 4.22V5.16C14.13 5.38 14 5.58 13.79 5.68L9.04 8.08L7.43 12.66C7.3 13.06 6.8 13.18 6.48 12.87L5.45 11.83C5.27 11.66 5.21 11.4 5.26 11.16L5.79 8.21L3.04 9.12C2.79 9.2 2.5 9.13 2.31 8.95L2 8.69V9.1Z" fill="currentColor"></path>
									</svg>
									14 days
								</span>
								<span class="h-1 w-1 rounded-full bg-jadoo-body/40"></span>
								<span>4.9/5 loved it</span>
							</div>
						</div>
					</div>
				</div>
			</section>

			<section id="services" class="relative py-20 lg:py-24">
				<div class="grid-dots absolute -right-2 top-16 hidden h-28 w-28 opacity-80 lg:block"></div>
				<div class="mx-auto max-w-[840px] text-center">
					<p class="text-sm font-semibold uppercase tracking-[0.28em] text-jadoo-body/60">Category</p>
					<h2 class="mt-5 text-[2.5rem] leading-tight sm:text-[3.35rem]">We Offer Best Services</h2>
				</div>

				<div class="mt-16 grid gap-6 md:grid-cols-2 lg:grid-cols-4 lg:gap-8">
					{
						services.map((service, index) => (
							<article
								class:list={['service-card reveal-up text-center']}
								style={`animation-delay: ${index * 120}ms;`}
							>
								<div class="mx-auto flex h-20 w-20 items-center justify-center rounded-[24px] bg-[#fff7ef]">
									<div class="h-12 w-12" set:html={service.icon}></div>
								</div>
								<h3 class="mt-8 font-sans text-[1.25rem] font-semibold text-jadoo-ink">{service.title}</h3>
								<p class="mt-4 text-sm leading-7 text-jadoo-body">{service.description}</p>
							</article>
						))
					}
				</div>
			</section>

			<section id="destinations" class="relative py-20 lg:py-24">
				<div class="mx-auto max-w-[840px] text-center">
					<p class="text-sm font-semibold text-jadoo-body/70">Top Selling</p>
					<h2 class="mt-4 text-[2.5rem] leading-tight sm:text-[3.35rem]">Top Destinations</h2>
				</div>

				<div class="mt-14 grid gap-8 lg:grid-cols-3">
					{
						destinations.map((destination, index) => (
							<article class="destination-card reveal-up" style={`animation-delay: ${index * 140}ms;`}>
								<div class="overflow-hidden">
									<img
										src={destination.image}
										alt={destination.name}
										class="h-[360px] w-full object-cover transition duration-500 hover:scale-105"
										loading="lazy"
										decoding="async"
									/>
								</div>
								<div class="flex items-center justify-between px-6 pt-6 text-lg font-medium text-jadoo-ink">
									<span>{destination.name}</span>
									<span>{destination.price}</span>
								</div>
								<div class="flex items-center gap-2 px-6 pb-6 pt-4 text-sm font-medium text-jadoo-body">
									<svg class="h-4 w-4 text-jadoo-ink" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
										<path d="M2 9.1L13.3 3.7C13.68 3.52 14.13 3.79 14.13 4.22V5.16C14.13 5.38 14 5.58 13.79 5.68L9.04 8.08L7.43 12.66C7.3 13.06 6.8 13.18 6.48 12.87L5.45 11.83C5.27 11.66 5.21 11.4 5.26 11.16L5.79 8.21L3.04 9.12C2.79 9.2 2.5 9.13 2.31 8.95L2 8.69V9.1Z" fill="currentColor"></path>
									</svg>
									{destination.duration}
								</div>
							</article>
						))
					}
				</div>

				<div class="pointer-events-none absolute right-[-1.5rem] top-[58%] hidden translate-y-[-50%] lg:block">
					<div class="relative h-32 w-24">
						<div class="absolute inset-y-0 left-5 w-px rotate-[10deg] rounded-full bg-jadoo-lilac/70"></div>
						<div class="absolute inset-y-3 left-10 w-px rotate-[18deg] rounded-full bg-jadoo-lilac/70"></div>
						<div class="absolute inset-y-6 left-16 w-px rotate-[26deg] rounded-full bg-jadoo-lilac/70"></div>
					</div>
				</div>
			</section>

			<section id="bookings" class="grid items-center gap-16 py-20 lg:grid-cols-[0.9fr_1.1fr] lg:py-24">
				<div>
					<p class="text-sm font-semibold text-jadoo-body/70">Easy and Fast</p>
					<h2 class="mt-4 max-w-[500px] text-[2.5rem] leading-tight sm:text-[3.35rem]">
						Book Your Next Trip In 3 Easy Steps
					</h2>

					<div class="mt-10 space-y-8">
						{
							steps.map((step, index) => (
								<div class="reveal-up flex items-start gap-5" style={`animation-delay: ${index * 120}ms;`}>
									<div class:list={['flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl shadow-[0_16px_26px_rgba(24,30,75,0.12)]', step.bg]}>
										<div class="h-6 w-6" set:html={step.icon}></div>
									</div>
									<div>
										<h3 class="font-sans text-lg font-semibold text-jadoo-ink">{step.title}</h3>
										<p class="mt-2 max-w-[430px] text-sm leading-7 text-jadoo-body">{step.text}</p>
									</div>
								</div>
							))
						}
					</div>
				</div>

				<div class="relative flex justify-center lg:justify-end">
					<div class="absolute left-[10%] top-[18%] h-40 w-40 rounded-full bg-[#59b1e6]/12 blur-3xl"></div>
					<article class="animate-pulse-shadow relative z-10 w-full max-w-[390px] rounded-[32px] bg-white p-6 shadow-[0_24px_60px_rgba(89,177,230,0.18)] reveal-up">
						<img
							src="https://images.unsplash.com/photo-1570077188670-e3a8d69ac5ff?auto=format&fit=crop&w=900&q=80"
							alt="Santorini coast"
							class="h-[180px] w-full rounded-[24px] object-cover"
							loading="lazy"
							decoding="async"
						/>
						<h3 class="mt-6 font-sans text-[1.35rem] font-semibold text-jadoo-ink">Trip To Greece</h3>
						<p class="mt-2 text-sm text-jadoo-body">14-29 June | by Robbin Joseph</p>

						<div class="mt-5 flex gap-3 text-jadoo-body">
							<span class="flex h-10 w-10 items-center justify-center rounded-full bg-[#f5f5fb]">
								<svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
									<path d="M10 5V15M5 10H15" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
								</svg>
							</span>
							<span class="flex h-10 w-10 items-center justify-center rounded-full bg-[#f5f5fb]">
								<svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
									<path d="M10 4C7.24 4 5 6.24 5 9C5 12.75 10 16 10 16C10 16 15 12.75 15 9C15 6.24 12.76 4 10 4Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path>
									<circle cx="10" cy="9" r="1.8" fill="currentColor"></circle>
								</svg>
							</span>
							<span class="flex h-10 w-10 items-center justify-center rounded-full bg-[#f5f5fb]">
								<svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
									<path d="M5 6H15V14H5V6Z" stroke="currentColor" stroke-width="1.8"></path>
									<path d="M8 4V8M12 4V8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
								</svg>
							</span>
						</div>

						<div class="mt-7 flex items-center justify-between text-sm text-jadoo-body">
							<div class="inline-flex items-center gap-3">
								<span class="flex h-9 w-9 items-center justify-center rounded-full bg-[#eef2ff]">
									<svg class="h-4 w-4 text-[#7a79ff]" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
