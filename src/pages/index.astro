</svg>`,
	},
	{
		title: 'Customization',
		description: 'We deliver outsourced aviation services for military customers.',
		icon: `
<svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <path d="M27 8H37L39.6 15.6C41.7 16.3 43.7 17.5 45.4 19L53 15.8L58 24.5L52.6 29.8C52.9 31.2 53 32.6 53 34C53 35.4 52.9 36.8 52.6 38.2L58 43.5L53 52.2L45.4 49C43.7 50.5 41.7 51.7 39.6 52.4L37 60H27L24.4 52.4C22.3 51.7 20.3 50.5 18.6 49L11 52.2L6 43.5L11.4 38.2C11.1 36.8 11 35.4 11 34C11 32.6 11.1 31.2 11.4 29.8L6 24.5L11 15.8L18.6 19C20.3 17.5 22.3 16.3 24.4 15.6L27 8Z" fill="#C7D2E2"/>
  <circle cx="32" cy="34" r="9" fill="#59B1E6"/>
  <circle cx="32" cy="34" r="4" fill="#FFF1DA"/>
</svg>`,
