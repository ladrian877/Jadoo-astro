  <path d="M20 10C23.866 10 27 13.134 27 17C27 22.25 20 30 20 30C20 30 13 22.25 13 17C13 13.134 16.134 10 20 10Z" stroke="white" stroke-width="2.8" stroke-linejoin="round"/>
  <circle cx="20" cy="17" r="2.5" fill="white"/>
</svg>`,
	},
	{
		title: 'Make Payment',
		text: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Urna, tortor tempus.',
		bg: 'bg-[#F15A2B]',
		icon: `
<svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <rect x="9" y="13" width="22" height="15" rx="3" stroke="white" stroke-width="2.8"/>
  <path d="M9 18H31" stroke="white" stroke-width="2.8" stroke-linecap="round"/>
  <path d="M14 23H18" stroke="white" stroke-width="2.8" stroke-linecap="round"/>
</svg>`,
	},
	{
		title: 'Reach Airport on Selected Date',
		text: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Urna, tortor tempus.',
		bg: 'bg-[#006380]',
		icon: planeIcon,
