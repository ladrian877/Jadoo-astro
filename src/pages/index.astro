<script is:inline>
	(() => {
		const animatedSelector =
			'.reveal-up, .animate-float-slow, .animate-float-fast, .animate-sway, .animate-pulse-shadow';
		const animatedElements = Array.from(document.querySelectorAll(animatedSelector));
		document.body.classList.add('viewport-animate');

		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		if (reducedMotion) {
			animatedElements.forEach((element) => {
				element.classList.add('is-visible');
			});
		} else {
			const visibilityObserver = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						entry.target.classList.toggle('is-visible', entry.isIntersecting);
					});
				},
				{
					threshold: 0.25,
					rootMargin: '0px 0px -8% 0px',
				},
			);

			animatedElements.forEach((element) => {
				visibilityObserver.observe(element);
			});

			window.addEventListener(
				'beforeunload',
				() => {
					visibilityObserver.disconnect();
				},
				{ once: true },
			);
		}

		const testimonialSection = document.getElementById('testimonials');
		if (!testimonialSection) return;

		const slides = Array.from(testimonialSection.querySelectorAll('[data-testimonial-slide]'));
		const dots = Array.from(testimonialSection.querySelectorAll('[data-testimonial-dot]'));
		if (slides.length < 2) return;

		let current = 0;

		const paint = () => {
			slides.forEach((slide, index) => {
				slide.classList.remove('is-active', 'is-prev');
				slide.setAttribute('aria-hidden', 'true');
				if (index === current) {
					slide.classList.add('is-active');
					slide.setAttribute('aria-hidden', 'false');
					return;
				}

				if (index === (current + 1) % slides.length) {
					slide.classList.add('is-prev');
				}
			});

			dots.forEach((dot, index) => {
				dot.classList.toggle('is-active', index === current);
			});
		};

		paint();

		if (reducedMotion) {
			return;
		}

		const intervalId = window.setInterval(() => {
			current = (current + 1) % slides.length;
			paint();
		}, 5000);

		window.addEventListener(
			'beforeunload',
			() => {
				window.clearInterval(intervalId);
			},
			{ once: true },
		);
	})();
</script>
